def query_prometheus(promql: str) -> list:
    """
    Run an instant query against the Thanos Query Frontend.
    Returns list of result dicts: [{metric: {}, value: [ts, val]}, ...]
    """
    url    = f"{THANOS_URL}/api/v1/query"
    params = {"query": promql, "time": int(time.time())}
    try:
        r = requests.get(url, params=params, timeout=10)
        r.raise_for_status()
        data = r.json()
        if data.get("status") == "success":
            return data.get("data", {}).get("result", [])
        return []
    except requests.exceptions.ConnectionError:
        return []
    except requests.exceptions.HTTPError:
        return []
    except requests.exceptions.Timeout:
        return []
    except Exception:
        return []


def query_prometheus_range(promql: str, lookback: str = "1h", step: str = "60") -> list:
    """
    Run a range query to get metric values over time.
    Useful for spotting spikes and trends.
    Returns list of {metric, values} dicts.
    """
    url     = f"{THANOS_URL}/api/v1/query_range"
    end     = int(time.time())
    # Parse lookback string like "1h", "30m", "4h"
    unit    = lookback[-1]
    amount  = int(lookback[:-1])
    seconds = amount * {"h": 3600, "m": 60, "d": 86400}.get(unit, 3600)
    start   = end - seconds

    params  = {"query": promql, "start": start, "end": end,
               "step": step, "dedup": "true", "partial_response": "true"}
    try:
        r = requests.get(url, params=params, timeout=15)
        r.raise_for_status()
        data = r.json()
        if data.get("status") == "success":
            return data.get("data", {}).get("result", [])
        return []
    except Exception:
        return []


def format_metric_value(value: str, unit: str) -> str:
    """Human-readable formatting for metric values."""
    try:
        v = float(value)
        if unit == "bytes":
            if v >= 1_073_741_824: return f"{v/1_073_741_824:.2f} GB"
            if v >= 1_048_576:     return f"{v/1_048_576:.2f} MB"
            if v >= 1_024:         return f"{v/1_024:.2f} KB"
            return f"{v:.0f} B"
        if unit == "bool":
            return "✅ UP" if v == 1 else "❌ DOWN"
        if unit == "seconds":
            return f"{v:.3f}s"
        if unit == "count":
            return f"{v:.0f}"
        return f"{v:.4g}"
    except (ValueError, TypeError):
        return str(value)


def collect_thanos_metrics() -> list:
    """
    Query all metrics defined in THANOS_METRICS.
    Returns list of result dicts with name, description, results, status.
    """
    collected = []

    for m in THANOS_METRICS:
        results = query_prometheus(m["promql"])

        # Summarise results into digestible form
        parsed = []
        for r in results:
            labels = r.get("metric", {})
            val    = r.get("value", [None, "N/A"])[1]
            parsed.append({
                "labels":    labels,
                "value":     val,
                "formatted": format_metric_value(val, m["unit"])
            })

        collected.append({
            "name":        m["name"],
            "description": m["description"],
            "promql":      m["promql"],
            "unit":        m["unit"],
            "results":     parsed,
            "available":   len(parsed) > 0
        })

    return collected


def summarise_metrics_for_ai(metrics: list) -> str:
    """Compact text summary of metrics for the AI prompt."""
    lines = []
    for m in metrics:
        if not m["available"]:
            lines.append(f"- {m['description']}: no data")
            continue
        for r in m["results"][:3]:   # Cap at 3 series per metric
            label_str = ", ".join(
                f"{k}={v}" for k, v in r["labels"].items()
                if k not in ("__name__",)
            )
            lines.append(
                f"- {m['description']}"
                f"{' [' + label_str + ']' if label_str else ''}: "
                f"{r['formatted']}"
            )
    return "\n".join(lines)


