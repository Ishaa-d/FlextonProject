        code = e.response.status_code
        print(f"  ⚠️  Copilot API error {code} — using stub.")
        return get_ai_summary_stub(query)
    except Exception as e:
        print(f"  ⚠️  Copilot error: {e} — using stub.")
        return get_ai_summary_stub(query)


