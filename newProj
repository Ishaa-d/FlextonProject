def _splunk_headers() -> dict:
    return {"Authorization": f"Bearer {SPLUNK_TOKEN}"} if SPLUNK_TOKEN else {}

def _splunk_auth():
    return None if SPLUNK_TOKEN else (SPLUNK_USER, SPLUNK_PASS)

def build_splunk_query(query: str, host: str = None) -> str:
    stop_words  = {"the","a","an","is","are","was","and","or",
                   "in","on","at","to","for","of","with","not"}
    keywords    = [w for w in query.lower().split() if w not in stop_words]
    kw_str      = " ".join(keywords[:5])
    host_filter = f'host="{host}"' if host else ""
    return (
        f'search index={SPLUNK_INDEX} {host_filter} {kw_str} '
        f'| head {MAX_SPLUNK_RESULTS} '
        f'| table _time, host, source, sourcetype, log_level, message '
        f'| sort -_time'
    ).strip()

def search_splunk(query: str, host: str = None, window: str = "1h") -> dict:
    spl      = build_splunk_query(query, host)
    job_data = {"search": spl, "earliest_time": f"-{window}",
                "latest_time": "now", "output_mode": "json"}
    try:
        r = requests.post(f"{SPLUNK_HOST}/services/search/jobs",
                          data=job_data, headers=_splunk_headers(),
                          auth=_splunk_auth(), verify=False, timeout=10)
        r.raise_for_status()
        sid = r.json().get("sid")
        if not sid:
            return {}
    except Exception as e:
        print(f"  ⚠️  Splunk error: {e} — skipping.")
        return {}

    status_url = f"{SPLUNK_HOST}/services/search/jobs/{sid}"
    waited = 0
    while waited < SPLUNK_MAX_WAIT:
        time.sleep(SPLUNK_POLL_INTERVAL)
        waited += SPLUNK_POLL_INTERVAL
        try:
            sr    = requests.get(status_url, params={"output_mode": "json"},
                                 headers=_splunk_headers(), auth=_splunk_auth(),
                                 verify=False, timeout=10)
            state = sr.json().get("entry",[{}])[0].get("content",{}).get("dispatchState","")
            if state == "DONE":  break
            if state == "FAILED": return {}
        except Exception:
            pass

    try:
        rr = requests.get(
            f"{SPLUNK_HOST}/services/search/jobs/{sid}/results",
            params={"output_mode": "json", "count": MAX_SPLUNK_RESULTS},
            headers=_splunk_headers(), auth=_splunk_auth(), verify=False, timeout=10)
        rr.raise_for_status()
        events      = rr.json().get("results", [])
        error_count = sum(1 for e in events if str(e.get("log_level","")).upper() in ("ERROR","ERR","CRITICAL"))
        warn_count  = sum(1 for e in events if str(e.get("log_level","")).upper() in ("WARN","WARNING"))
        return {"events": events, "error_count": error_count,
                "warn_count": warn_count, "spl": spl, "window": window}
    except Exception as e:
        print(f"  ⚠️  Splunk results error: {e}")
        return {}


