def build_ai_prompt(query, incidents, pages, splunk_data, metrics) -> str:
    # ServiceNow
    snow_summary = ""
    for inc in incidents[:3]:
        snow_summary += (
            f"- {inc.get('number')} (P{inc.get('priority','?')}): "
            f"{inc.get('short_description','')} | "
            f"Resolution: {inc.get('close_notes','none')[:150]}\n"
        )

    # Confluence
    conf_summary = ""
    for page in pages[:2]:
        excerpt = page.get("excerpt","").replace("@@@hl@@@","").replace("@@@endhl@@@","")
        conf_summary += f"- {page.get('title','')}: {excerpt[:200]}\n"

    # Splunk
    splunk_summary = ""
    if splunk_data:
        events      = splunk_data.get("events", [])
        error_count = splunk_data.get("error_count", 0)
        warn_count  = splunk_data.get("warn_count", 0)
        splunk_summary = f"Log stats: {len(events)} lines, {error_count} errors, {warn_count} warnings.\n"
        for e in events[:5]:
            splunk_summary += (
                f"  [{e.get('_time','')[:19]}] "
                f"{e.get('log_level','')}: "
                f"{str(e.get('message',''))[:120]}\n"
            )

    # Prometheus/Thanos
    metrics_summary = summarise_metrics_for_ai(metrics) if metrics else "No metrics available."

    return f"""You are an expert platform/infrastructure engineer diagnosing a production incident.

INCIDENT DESCRIPTION:
{query}

PAST SIMILAR INCIDENTS (ServiceNow):
{snow_summary or 'None found.'}

RELEVANT RUNBOOKS (Confluence):
{conf_summary or 'None found.'}

LIVE LOG SIGNALS (Splunk):
{splunk_summary or 'No Splunk data.'}

LIVE PROMETHEUS/THANOS METRICS:
{metrics_summary}

Based on ALL signals above, provide a concise analysis in this exact structure:

MOST LIKELY CAUSE:
[1-2 sentences — what is probably wrong and why]

SUPPORTING EVIDENCE:
[3-4 bullet points referencing specific metrics, log signals, or past incidents]

SUGGESTED NEXT STEPS:
[4-5 numbered, immediately actionable steps for the on-call engineer]

CONFIDENCE:
[High / Medium / Low — one sentence explaining why]

Be specific. Reference actual metric values and incident numbers where relevant.
Do not repeat input data verbatim. Focus entirely on what to do next."""


