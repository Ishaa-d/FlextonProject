def get_ai_summary(query, incidents, pages, splunk_data, metrics) -> str:
    if not COPILOT_TOKEN:
        print("  ℹ️  COPILOT_TOKEN not set — using stub response.")
        print("      Set export COPILOT_TOKEN=your_token to enable real AI.\n")
        return get_ai_summary_stub(query)

    prompt  = build_ai_prompt(query, incidents, pages, splunk_data, metrics)
