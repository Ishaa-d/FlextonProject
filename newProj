        print(f"      🔗 {CONFLUENCE_BASE_URL}/pages/{page_id}")


def display_splunk(splunk_data: dict):
    window = splunk_data.get("window","1h") if splunk_data else "1h"
    print("\n  ┌──────────────────────────────────────────────────────────┐")
    print(f"  │  📡  SPLUNK — Live Logs  (last {window})                       │")
    print("  └──────────────────────────────────────────────────────────┘")
    if not splunk_data:
        print("  Splunk unavailable or no results.\n"); return
    events      = splunk_data.get("events",[])
    error_count = splunk_data.get("error_count",0)
    warn_count  = splunk_data.get("warn_count",0)
    spl         = splunk_data.get("spl","")
    print(f"\n  📊 {len(events)} log lines  |  🔴 {error_count} errors  |  🟡 {warn_count} warnings\n")
    if not events:
        print(f"  No matching log lines. SPL used: {spl}\n"); return
    for event in events:
        ts      = event.get("_time","")[:19].replace("T"," ")
        host    = event.get("host","")
        level   = event.get("log_level","INFO")
        message = event.get("message", str(event))[:120]
        print(f"  {log_level_icon(level)} [{ts}] {host}")
        print(f"     {message}")
    print(f"\n  🔍 SPL: {spl}")


def display_metrics(metrics: list):
    print("\n  ┌──────────────────────────────────────────────────────────┐")
    print("  │  📈  PROMETHEUS / THANOS — Live Metrics                   │")
    print("  └──────────────────────────────────────────────────────────┘")

    if not metrics:
        print("  No metrics collected.\n"); return

    available = [m for m in metrics if m["available"]]
    missing   = [m for m in metrics if not m["available"]]

    if not available:
        print(f"  ⚠️  Thanos endpoint unreachable: {THANOS_URL}")
        print("      Check port 10903 is accessible from this host.\n")
        return

    print()
    for m in available:
        icon = metric_health_icon(m)
        print(f"  {icon}  {m['description']}")
        for r in m["results"][:3]:
            label_str = ", ".join(
                f"{k}={v}" for k, v in r["labels"].items()
                if k not in ("__name__",)
            )
            label_display = f" [{label_str}]" if label_str else ""
            print(f"       {r['formatted']}{label_display}")

    if missing:
        print(f"\n  ⚫ No data: {', '.join(m['description'] for m in missing)}")

    print(f"\n  🔗 {THANOS_URL}/graph")


def display_ai_summary(summary: str):
    print("\n  ╔══════════════════════════════════════════════════════════╗")
    print("  ║  🤖  AI ROOT CAUSE SUMMARY  (GitHub Copilot)             ║")
    print("  ╚══════════════════════════════════════════════════════════╝\n")
    for line in summary.splitlines():
        print(f"  {line}")
    print()


def display_all(incidents, pages, splunk_data, metrics, ai_summary, query, host, window):
    print("\n" + "═" * 64)
    print(f"  🔍  INCIDENT INTELLIGENCE  —  Phase 5")
    print(f"  Query : \"{query}\"")
    if host: print(f"  Host  : {host}")
    print(f"  Window: last {window}")
    print("═" * 64)

    display_servicenow(incidents)
    display_confluence(pages)
    display_splunk(splunk_data)
    display_metrics(metrics)
    display_ai_summary(ai_summary)

    print("═" * 64)
    print("  💡 --no-ai  skips AI summary for faster raw output")
    print("  💡 --window 4h looks further back in Splunk logs")
    print("═" * 64 + "\n")


# ══════════════════════════════════════════════════════════════
#  Main
# ══════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        description="Incident Intelligence — ServiceNow + Confluence + Splunk + Thanos + AI"
    )
    parser.add_argument("query", nargs="?",
                        help="Describe the issue (e.g. 'thanos store disk full')")
    parser.add_argument("--host", "-H", default=None,
                        help="Filter Splunk logs to a specific host")
    parser.add_argument("--window", "-w", default="1h",
                        help="Splunk + metrics lookback: 30m, 1h, 4h, 24h (default: 1h)")
    parser.add_argument("--no-ai", action="store_true",
                        help="Skip AI summary (faster, raw results only)")
    args = parser.parse_args()

    if not args.query:
        print("\n🔍 Incident Intelligence Assistant — Phase 5")
        query = input("   Describe the issue: ").strip()
    else:
        query = args.query.strip()

    if not query:
        print("❌ Please provide a search query.")
        sys.exit(1)

    host   = args.host
    window = args.window

    print(f"\n   Searching all sources in parallel...")
    print(f"   Sources: ServiceNow | Confluence | Splunk | Thanos/Prometheus\n")

    incidents, pages, splunk_data, metrics = [], [], {}, []

    # Run all four data sources concurrently
    with ThreadPoolExecutor(max_workers=4) as executor:
        futures = {
            executor.submit(search_incidents, query):             "snow",
            executor.submit(search_confluence, query):            "confluence",
            executor.submit(search_splunk, query, host, window):  "splunk",
            executor.submit(collect_thanos_metrics):              "metrics"
        }
        for future in as_completed(futures):
            source = futures[future]
            result = future.result()
            if source == "snow":        incidents   = result
            elif source == "confluence":pages       = result
            elif source == "splunk":    splunk_data = result
            else:                       metrics     = result

    # AI runs after all data is in hand
    ai_summary = ""
    if not args.no_ai:
        print("   Generating AI root cause summary...")
        ai_summary = get_ai_summary(query, incidents, pages, splunk_data, metrics)
    else:
        ai_summary = "AI summary skipped (--no-ai flag used)."

    display_all(incidents, pages, splunk_data, metrics, ai_summary, query, host, window)


if __name__ == "__main__":
    main()
