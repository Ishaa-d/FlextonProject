def format_priority(p: str) -> str:
    return {"1":"🔴 P1","2":"🟠 P2","3":"🟡 P3","4":"🟢 P4"}.get(p,"⚪ P?")

def format_date(date_str: str) -> str:
    if not date_str: return "Unknown"
    try:    return datetime.strptime(date_str, "%Y-%m-%d %H:%M:%S").strftime("%b %d, %Y")
    except: return date_str

def wrap_text(text: str, prefix: str, width: int = 65) -> str:
    words, lines, line = text.split(), [], prefix
    for word in words:
        if len(line) + len(word) + 1 > width:
            lines.append(line); line = prefix + word + " "
        else:
            line += word + " "
    if line.strip(): lines.append(line)
    return "\n".join(lines)

def clean_excerpt(text: str) -> str:
    return text.replace("@@@hl@@@","").replace("@@@endhl@@@","").strip()

def log_level_icon(level: str) -> str:
    level = str(level).upper()
    if level in ("ERROR","ERR","CRITICAL"): return "🔴"
    if level in ("WARN","WARNING"):         return "🟡"
    return "⚪"

def metric_health_icon(m: dict) -> str:
    """Traffic light based on metric name and value heuristics."""
    if not m["available"]: return "⚫"
    name = m["name"]
    try:
        val = float(m["results"][0]["value"])
        if name == "store_up":           return "✅" if val == 1 else "❌"
        if name == "compaction_failures":return "❌" if val > 0 else "✅"
        if name == "objstore_failures":  return "❌" if val > 0 else "✅"
        if name == "disk_usage":
            # Flag if less than 10GB free
            return "❌" if val < 10_737_418_240 else ("🟡" if val < 21_474_836_480 else "✅")
    except Exception:
        pass
    return "ℹ️"


